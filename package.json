{
  "name": "bx-cf-fe",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:pc": "turbo dev --filter=pc-web",
    "dev:mobile": "turbo dev --filter=mobile-web",
    "dev:admin": "turbo dev --filter=admin-portal",
    "dev:server": "node mock/server.js",
    "dev:all": "concurrently \"turbo dev\" \"node mock/server.js\"",
    "start": "turbo dev",
    "build": "turbo build",
    "build:debug": "turbo build -- --sourcemap --minify false",
    "build:debug:pc": "turbo build --filter=pc-web -- --sourcemap --minify false",
    "build:debug:mobile": "turbo build --filter=mobile-web -- --sourcemap --minify false",
    "build:debug:admin": "turbo build --filter=admin-portal -- --sourcemap --minify false",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:pc": "turbo test:e2e --filter=pc-web",
    "test:e2e:mobile": "turbo test:e2e --filter=mobile-web",
    "test:e2e:admin": "turbo test:e2e --filter=admin-portal",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "watch:json-server": "node mock/server.js",
    "check": "turbo check",
    "check:api-paths": "node scripts/check-api-paths.mjs",
    "wbs:pull": "node docs/wbs-pull.js",
    "wbs:sync": "node docs/wbs-sync.js",
    "wbs:force-sync": "node docs/wbs-force-sync.js",
    "gen:api": "node scripts/gen-api.mjs && biome format --write packages/shared/src/shared/api",
    "gen:readme": "node scripts/gen-readme-html.mjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^1.9.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.131.5",
    "@tanstack/router-plugin": "^1.121.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "json-server": "1.0.0-beta.15",
    "madge": "^8.0.0",
    "marked": "^18.0.5",
    "openapi-typescript": "^7.13.0",
    "oxc": "^1.0.0",
    "turbo": "^2.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "web-vitals": "^5.2.0"
  },
  "pnpm": {
    "allowedBuildScripts": ["core-js-pure", "esbuild", "unrs-resolver", "@biomejs/biome"]
  }
}
