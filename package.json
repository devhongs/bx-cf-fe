    "@tanstack/react-router": "^1.130.2",
    "@tanstack/react-router-devtools": "^1.131.5",
    "@tanstack/router-plugin": "^1.121.2",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.3",
    "json-server": "1.0.0-beta.3",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.0",
    "@tanstack/eslint-plugin-query": "^5.90.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/axios": "^0.14.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.0.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
