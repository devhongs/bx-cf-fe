{
  "name": "bx-cf-fe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port 3000\" \"json-server db.json --port 3333\"",
    "dev:client": "vite --port 3000",
    "dev:server": "json-server db.json --port 3333",
    "start": "vite --port 3000",
    "build": "tsc -p tsconfig.build.json && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:oxc": "oxc lint .",
    "format": "biome format --write .",
    "watch:json-server": "json-server db.json --port 3333",
    "check": "biome check --write .",
    "check:circular": "madge --circular --extensions ts,tsx src"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.130.2",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dayjs": "^1.11.13",
    "i18next": "^26.2.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.16.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^1.9.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.131.5",
    "@tanstack/router-plugin": "^1.121.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "json-server": "1.0.0-beta.15",
    "madge": "^8.0.0",
    "oxc": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "web-vitals": "^5.2.0"
  },
  "pnpm": {
    "allowedBuildScripts": ["core-js-pure", "esbuild", "unrs-resolver", "@biomejs/biome"]
  }
}
