# API 서버 주소
# 개발 시에는 상대경로를 사용해 Vite dev server 프록시(vite.config.ts의 server.proxy)를 태운다.
# 브라우저 입장에서 same-origin이 되어 CORS/크로스도메인 쿠키 문제가 없다.
#VITE_API_URL=http://192.168.110.217/channel/backend/api/v1
#VITE_API_URL=http://localhost:18081/channel/backend/api/v1
#VITE_API_URL=http://localhost:3333
VITE_API_URL=/channel/backend/api/v1
